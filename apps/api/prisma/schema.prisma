generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum MachineConnectivity {
  OFFLINE
  ONLINE
}

enum MachineOperational {
  UNAVAILABLE
  VERIFYING
  AVAILABLE
  RESERVED
  RUNNING
  DEGRADED
  MAINTENANCE
}

enum ModerationStatus {
  CLEAR
  SUSPENDED
  QUARANTINED
}

// Stable, software-readable causes for a quarantine decision. The human-facing
// title/description/severity/impact for each code lives in
// apps/api/src/quarantine-reason-registry.ts, not in the database - the code
// here is the only thing other code may branch on.
enum QuarantineReasonCode {
  CRITICAL_GPU_IDENTITY_CHANGE
  DIAGNOSTIC_COMPLETION_RACE
  STALE_CLAIM
  STALE_JOB
  WORKSPACE_CLEANUP_FAILED
  AGENT_SECURITY_FAILURE
  GPU_HEALTH_CHECK_FAILED
  GPU_UNAVAILABLE
  DOCKER_UNAVAILABLE
  NVIDIA_RUNTIME_UNAVAILABLE
  UNKNOWN
}

// One immutable row per quarantine lifecycle transition. Machine.moderationStatus
// / quarantineReasonCode / quarantinedAt are only ever a snapshot of "now" - this
// table is the durable history a new quarantine must never overwrite.
enum QuarantineEventStatus {
  ENTERED
  DIAGNOSTIC
  CLEARED
  REENTERED
}

enum DiagnosticRunStatus {
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
}

enum DiagnosticTrigger {
  OWNER
  SYSTEM
  ADMIN
}

// Registration lifecycle, orthogonal to moderationStatus/operational: a machine
// can be lifecycle ACTIVE while quarantined, or lifecycle STALE while CLEAR.
enum MachineLifecycleStatus {
  ACTIVE
  STALE
  OFFLINE
  RETIRED
}

enum ListingStatus {
  DRAFT
  PENDING_GPU_VERIFICATION
  ACTIVE
  RESERVED
  HIDDEN_OFFLINE
  PAUSED
  ARCHIVED
  SUSPENDED
}

enum ListingResourceMode {
  FULL_MACHINE
  SELECTED_ACCELERATORS
  COMPUTE_POOL
}

enum AcceleratorOperationalStatus {
  DISCOVERED
  VERIFYING
  AVAILABLE
  RESERVED
  RUNNING
  DEGRADED
  MAINTENANCE
  MISSING
  QUARANTINED
}

enum ResourceAllocationStatus {
  HELD
  CONFIRMED
  ACTIVE
  RELEASED
  CANCELLED
}

enum BookingStatus {
  CREATED
  AWAITING_DEPOSIT
  FUNDED
  STARTING
  ACTIVE
  DEGRADED
  COMPLETED
  DISPUTED
  SETTLED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  ESCROW_PENDING
  ESCROW_FUNDED
  SETTLEMENT_PENDING
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  RELEASED
  FROZEN
}

enum JobType {
  GPU_DIAGNOSTIC
  WORKSPACE_PREPARE
  GPU_PROOF
}

enum JobStatus {
  DRAFT
  QUEUED
  ASSIGNED
  DOWNLOADING
  PREPARING
  RUNNING
  UPLOADING_RESULTS
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  TIMED_OUT
  REJECTED
  QUARANTINED
}

enum WorkspaceRelease {
  BETA
  UPCOMING
  EXPERIMENTAL
  SUSPENDED
}

enum MachineWorkspaceState {
  READY
  LIMITED
  INSTALL_REQUIRED
  INCOMPATIBLE
  OWNER_DISABLED
}

enum WorkspaceSessionStatus {
  RESERVED
  PREPARING
  READY
  RUNNING
  STOP_REQUESTED
  STOPPING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  QUARANTINED
}

enum SessionTerminationReason {
  USER_STOP
  OWNER_EMERGENCY_STOP
  PLATFORM_EMERGENCY_STOP
  COMPLETED
  TIMEOUT
  AGENT_OFFLINE
  SECURITY_POLICY
  EXECUTION_FAILED
}

enum MiningResourceKind {
  CPU
  GPU
}

enum MiningMode {
  DISABLED
  GPUBNB_MANAGED
  OWNER_POOL
}

enum MiningRuntimeState {
  IDLE
  STARTING
  MINING
  PREEMPTING
  VERIFYING_STOP
  RENTAL_BLOCKED
  STOPPED
  QUARANTINED
  EMERGENCY_STOPPED
}

enum MiningEventType {
  CONFIGURATION_CHANGED
  START_REQUESTED
  STARTED
  STOP_REQUESTED
  STOP_VERIFIED
  STOP_FAILED
  RENTAL_PREEMPTED
  RENTAL_RELEASED
  CLEANUP_VERIFIED
  AUTO_RESUME_REQUESTED
  QUARANTINED
  EMERGENCY_STOPPED
  HEARTBEAT
}

enum MiningAuditActorType {
  OWNER
  AGENT
  PLATFORM
  SYSTEM
}

model User {
  id String @id @default(cuid())
  wallet String @unique
  pseudonym String @unique
  email String? @unique
  firstName String?
  lastName String?
  phone String?
  countryCode String?
  language String @default("fr")
  canRent Boolean @default(true)
  canHost Boolean @default(false)
  profileCompletedAt DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  profile Profile?
  machines Machine[]
  listings GpuListing[]
  bookings Booking[] @relation("BuyerBookings")
  reviewsWritten Review[] @relation("ReviewsWritten")
  forumTopics ForumTopic[]
  forumPosts ForumPost[]
  conversationMembers ConversationMember[]
  messages Message[]
  jobs Job[]
  workspaceSessions WorkspaceSession[]
}

model Profile {
  id String @id @default(cuid())
  userId String @unique
  bio String?
  avatarUrl String?
  companyName String?
  websiteUrl String?
  reliabilityScore Int @default(0)
  completedSessions Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Machine {
  id String @id @default(cuid())
  ownerId String
  agentPublicKey String @unique
  agentVersion String?
  keyCreatedAt DateTime @default(now())
  keyLastUsedAt DateTime?
  keyRevokedAt DateTime?
  operatingSystem String?
  osVersion String?
  cpuModel String?
  cpuCount Int?
  ramTotalMiB Int?
  diskTotalMiB Int?
  cudaVersion String?
  dockerAvailable Boolean @default(false)
  nvidiaRuntimeAvailable Boolean @default(false)
  virtualizationAvailable Boolean @default(false)
  desktopGpuRenderingAvailable Boolean @default(false)
  connectivity MachineConnectivity @default(OFFLINE)
  operational MachineOperational @default(UNAVAILABLE)
  moderationStatus ModerationStatus @default(CLEAR)
  lastHeartbeatAt DateTime?
  lastCounter BigInt @default(0)
  gpuUuid String?
  gpuModel String?
  vramMiB Int?
  driverVersion String?
  gpuVendor String? @db.VarChar(20)
  lastCudaProbeOk Boolean @default(false)
  verifiedAt DateTime?
  // Current-state snapshot only. MachineQuarantineEvent below is the durable,
  // append-only history - these fields may be overwritten freely.
  quarantineReasonCode QuarantineReasonCode?
  quarantinedAt DateTime?
  lastDiagnosticRunId String?
  lastDiagnosticAt DateTime?
  lifecycleStatus MachineLifecycleStatus @default(ACTIVE)
  retiredAt DateTime?
  retiredReason String? @db.VarChar(500)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings GpuListing[]
  accelerators Accelerator[]
  machineAllocations MachineAllocation[]
  heartbeats Heartbeat[]
  jobs Job[]
  workspaceSessions WorkspaceSession[]
  workspaces MachineWorkspace[]
  miningResources MiningResource[]
  miningAuditLogs MiningAuditLog[]
  quarantineEvents MachineQuarantineEvent[]
  diagnosticRuns DiagnosticRun[]
}

model DiagnosticRun {
  id String @id @default(cuid())
  machineId String
  status DiagnosticRunStatus @default(RUNNING)
  // Array of {name, status: PASS|FAIL|WARNING|UNKNOWN|NOT_CHECKED, value, details,
  // measuredAt, source} - see quarantine-reason-registry.ts / diagnostic-run-service.ts.
  checks Json?
  triggeredBy DiagnosticTrigger
  triggeredById String?
  error String? @db.VarChar(500)
  startedAt DateTime @default(now())
  completedAt DateTime?
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  quarantineEvents MachineQuarantineEvent[]
  @@index([machineId, startedAt])
  @@index([machineId, status])
}

model MachineQuarantineEvent {
  id String @id @default(cuid())
  machineId String
  status QuarantineEventStatus
  reasonCode QuarantineReasonCode
  reason String @db.VarChar(500)
  details Json?
  source String @db.VarChar(120)
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  diagnosticRunId String?
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  diagnosticRun DiagnosticRun? @relation(fields: [diagnosticRunId], references: [id], onDelete: SetNull)
  @@index([machineId, createdAt])
}

model Accelerator {
  id String @id @default(cuid())
  machineId String
  hardwareUuid String
  slotIndex Int?
  vendor String? @db.VarChar(40)
  model String @db.VarChar(160)
  vramMiB Int
  driverVersion String? @db.VarChar(80)
  cudaVersion String? @db.VarChar(40)
  status AcceleratorOperationalStatus @default(DISCOVERED)
  moderationStatus ModerationStatus @default(CLEAR)
  isolationVerified Boolean @default(false)
  verifiedAt DateTime?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  listings ListingAccelerator[]
  allocations AcceleratorAllocation[]
  miningResource MiningResource?
  @@unique([machineId, hardwareUuid])
  @@index([machineId, status])
}

model GpuListing {
  id String @id @default(cuid())
  ownerId String
  machineId String
  title String @db.VarChar(120)
  description String @db.VarChar(3000)
  hourlyLamports BigInt
  status ListingStatus @default(PENDING_GPU_VERIFICATION)
  resourceMode ListingResourceMode @default(FULL_MACHINE)
  minimumAccelerators Int?
  maximumAccelerators Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])
  accelerators ListingAccelerator[]
  bookings Booking[]
  @@index([status, createdAt])
  @@index([machineId, resourceMode, status])
}

model ListingAccelerator {
  listingId String
  acceleratorId String
  createdAt DateTime @default(now())
  listing GpuListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Restrict)
  @@id([listingId, acceleratorId])
  @@index([acceleratorId])
}

model Booking {
  id String @id @default(cuid())
  buyerId String
  listingId String
  idempotencyKey String
  startsAt DateTime
  endsAt DateTime
  quotedLamports BigInt
  validSeconds Int @default(0)
  expectedSeconds Int
  status BookingStatus @default(CREATED)
  escrowAddress String?
  depositSignature String? @unique
  createdAt DateTime @default(now())
  buyer User @relation("BuyerBookings", fields: [buyerId], references: [id])
  listing GpuListing @relation(fields: [listingId], references: [id])
  machineAllocation MachineAllocation?
  acceleratorAllocations AcceleratorAllocation[]
  payment Payment?
  usageSamples UsageSample[]
  reviews Review[]
  jobs Job[]
  workspaceSessions WorkspaceSession[]
  @@unique([buyerId, idempotencyKey])
  @@index([listingId, startsAt, endsAt])
}

model MachineAllocation {
  id String @id @default(cuid())
  bookingId String @unique
  machineId String
  status ResourceAllocationStatus @default(HELD)
  startsAt DateTime
  endsAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  @@index([machineId, startsAt, endsAt])
}

model AcceleratorAllocation {
  id String @id @default(cuid())
  bookingId String
  acceleratorId String
  status ResourceAllocationStatus @default(HELD)
  startsAt DateTime
  endsAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Restrict)
  @@unique([bookingId, acceleratorId])
  @@index([acceleratorId, startsAt, endsAt])
}

model WorkspaceDefinition {
  id String @id @default(cuid())
  slug String @unique @db.VarChar(80)
  version Int @default(1)
  name String @db.VarChar(120)
  category String @db.VarChar(40)
  release WorkspaceRelease @default(UPCOMING)
  globallyEnabled Boolean @default(true)
  manifest Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  machines MachineWorkspace[]
}

model MachineWorkspace {
  id String @id @default(cuid())
  machineId String
  workspaceId String
  compatibilityScore Int
  state MachineWorkspaceState
  enabledByOwner Boolean @default(false)
  analysis Json
  configuration Json?
  hourlyLamports BigInt?
  analyzedAt DateTime @default(now())
  testedAt DateTime?
  sessions WorkspaceSession[]
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  workspace WorkspaceDefinition @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  @@unique([machineId, workspaceId])
  @@index([machineId, enabledByOwner, state])
}

model WorkspaceSession {
  id String @id @default(cuid())
  bookingId String
  renterId String
  machineId String
  machineWorkspaceId String
  jobId String? @unique
  status WorkspaceSessionStatus @default(RESERVED)
  isolationType String @db.VarChar(32)
  resourceLimits Json
  connectionType String? @db.VarChar(32)
  connectionMetadata Json?
  lastMetricCounter BigInt @default(0)
  preparationProgress Int @default(0)
  preparationStep String? @db.VarChar(80)
  preparationRequestedAt DateTime?
  preparationStartedAt DateTime?
  preparationCompletedAt DateTime?
  readyDeadlineAt DateTime?
  preparationAttempts Int @default(0)
  startedAt DateTime?
  readyAt DateTime?
  endedAt DateTime?
  expiresAt DateTime
  terminationReason SessionTerminationReason?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  renter User @relation(fields: [renterId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  machineWorkspace MachineWorkspace @relation(fields: [machineWorkspaceId], references: [id], onDelete: Restrict)
  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  metrics WorkspaceMetric[]
  events WorkspaceSessionEvent[]
  @@unique([bookingId, machineWorkspaceId])
  @@index([renterId, createdAt])
  @@index([machineId, status])
  @@index([bookingId])
  @@index([status, readyDeadlineAt])
}

model WorkspaceMetric {
  id String @id @default(cuid())
  sessionId String
  counter BigInt
  capturedAt DateTime
  intervalSeconds Int
  gpuUtilization Int
  memoryUsedMiB Int
  temperatureC Int
  cpuUtilization Int
  ramUsedMiB Int
  diskUsedMiB Int
  networkRxBytes BigInt
  networkTxBytes BigInt
  available Boolean
  workloadProof Boolean
  signatureHash String @unique
  session WorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, counter])
  @@index([sessionId, capturedAt])
}

model WorkspaceSessionEvent {
  id String @id @default(cuid())
  sessionId String
  actorType String @db.VarChar(24)
  actorId String?
  action String @db.VarChar(80)
  details Json?
  createdAt DateTime @default(now())
  session WorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model Job {
  id String @id @default(cuid())
  bookingId String
  renterId String
  machineId String
  type JobType
  status JobStatus @default(QUEUED)
  parameters Json
  result Json?
  errorCode String?
  cancelRequestedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  currentAttemptId String?
  leaseTokenHash String? @db.VarChar(64)
  leaseExpiresAt DateTime?
  lastAgentReportAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  renter User @relation(fields: [renterId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  attempts JobAttempt[]
  logs JobLog[]
  artifacts JobArtifact[]
  workspaceSession WorkspaceSession?
  @@index([renterId, createdAt])
  @@index([machineId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([machineId, currentAttemptId])
}

model JobAttempt {
  id String @id @default(cuid())
  jobId String
  sequence Int
  agentVersion String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  exitCode Int?
  failureReason String?
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, sequence])
}

model JobLog {
  id String @id @default(cuid())
  jobId String
  level String @db.VarChar(16)
  message String @db.VarChar(2000)
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}

model JobArtifact {
  id String @id @default(cuid())
  jobId String
  kind String @db.VarChar(32)
  sha256 String @db.VarChar(64)
  sizeBytes Int
  storageKey String @db.VarChar(500)
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}

model Payment {
  id String @id @default(cuid())
  bookingId String @unique
  grossLamports BigInt
  payableLamports BigInt @default(0)
  platformLamports BigInt @default(0)
  providerLamports BigInt @default(0)
  refundLamports BigInt @default(0)
  status PaymentStatus @default(ESCROW_PENDING)
  settlementSignature String? @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Heartbeat {
  id String @id @default(cuid())
  machineId String
  counter BigInt
  agentTimestamp DateTime
  receivedAt DateTime @default(now())
  gpuUtilization Int
  memoryUsedMiB Int
  temperatureC Int
  cudaProbeOk Boolean
  sessionId String?
  signatureHash String @unique
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  @@unique([machineId, counter])
  @@index([machineId, receivedAt])
}

model UsageSample {
  id String @id @default(cuid())
  bookingId String
  timestamp DateTime
  available Boolean
  workloadProof Boolean
  gpuUtilization Int
  temperatureC Int
  sourceHash String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@unique([bookingId, timestamp])
}

model Conversation {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  members ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId String
  joinedAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
}

model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String @db.VarChar(4000)
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Review {
  id String @id @default(cuid())
  bookingId String
  reviewerId String
  rating Int
  comment String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
  reviewer User @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  @@unique([bookingId, reviewerId])
}

model ForumTopic {
  id String @id @default(cuid())
  authorId String
  title String @db.VarChar(160)
  body String @db.VarChar(10000)
  category String @db.VarChar(80)
  locked Boolean @default(false)
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id])
  posts ForumPost[]
}

model ForumPost {
  id String @id @default(cuid())
  topicId String
  authorId String
  body String @db.VarChar(10000)
  createdAt DateTime @default(now())
  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model MiningResource {
  id String @id
  machineId String
  kind MiningResourceKind
  resourceKey String @db.VarChar(200)
  displayName String @db.VarChar(200)
  acceleratorId String? @unique
  cpuPackageIndex Int?
  cpuLogicalCores Int?
  enabled Boolean @default(true)
  quarantined Boolean @default(false)
  runtimeState MiningRuntimeState @default(IDLE)
  activeRentalId String?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  accelerator Accelerator? @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  configuration MiningConfiguration?
  runtimeEvents MiningRuntimeEvent[]
  auditLogs MiningAuditLog[]
  @@unique([machineId, resourceKey])
  @@index([machineId, kind])
  @@index([runtimeState])
}

model MiningConfiguration {
  id String @id
  resourceId String @unique
  mode MiningMode @default(DISABLED)
  profileId String? @db.VarChar(96)
  walletAddress String? @db.VarChar(160)
  workerName String @db.VarChar(64)
  ownerPoolEndpoint String? @db.VarChar(300)
  ownerPoolSecretRef String? @db.VarChar(200)
  autoResumeAfterRental Boolean @default(false)
  maximumTemperatureC Int?
  maximumPowerWatts Int?
  maximumCpuPercent Int?
  cpuThreadCount Int?
  gpuIntensityPercent Int?
  platformFeeBasisPoints Int @default(0)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resource MiningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  auditLogs MiningAuditLog[]
  @@index([mode])
}

model MiningRuntimeEvent {
  id String @id
  resourceId String
  eventType MiningEventType
  stateBefore MiningRuntimeState?
  stateAfter MiningRuntimeState
  reservationId String?
  idempotencyKey String @unique @db.VarChar(160)
  agentCounter BigInt?
  payload Json?
  occurredAt DateTime
  createdAt DateTime @default(now())
  resource MiningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@index([resourceId, occurredAt])
  @@index([reservationId])
}

model MiningAuditLog {
  id String @id
  machineId String
  resourceId String?
  configurationId String?
  actorType MiningAuditActorType
  actorId String @db.VarChar(160)
  action String @db.VarChar(120)
  requestId String? @db.VarChar(160)
  ipAddressHash String? @db.VarChar(128)
  previousValue Json?
  nextValue Json?
  createdAt DateTime @default(now())
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  resource MiningResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  configuration MiningConfiguration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  @@index([machineId, createdAt])
  @@index([resourceId, createdAt])
}
