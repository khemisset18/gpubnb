generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum MachineConnectivity {
  OFFLINE
  ONLINE
}
enum MachineOperational {
  UNAVAILABLE
  VERIFYING
  AVAILABLE
  RESERVED
  RUNNING
  DEGRADED
  MAINTENANCE
}
enum ModerationStatus {
  CLEAR
  SUSPENDED
  QUARANTINED
}
enum ListingStatus {
  DRAFT
  PENDING_GPU_VERIFICATION
  ACTIVE
  RESERVED
  HIDDEN_OFFLINE
  SUSPENDED
}
enum BookingStatus {
  CREATED
  AWAITING_DEPOSIT
  FUNDED
  STARTING
  ACTIVE
  DEGRADED
  COMPLETED
  DISPUTED
  SETTLED
  REFUNDED
  CANCELLED
}
enum PaymentStatus {
  ESCROW_PENDING
  ESCROW_FUNDED
  SETTLEMENT_PENDING
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  RELEASED
  FROZEN
}
enum JobType {
  GPU_DIAGNOSTIC
}
enum JobStatus {
  DRAFT
  QUEUED
  ASSIGNED
  DOWNLOADING
  PREPARING
  RUNNING
  UPLOADING_RESULTS
  COMPLETED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  TIMED_OUT
  REJECTED
  QUARANTINED
}
enum WorkspaceRelease {
  BETA
  UPCOMING
  EXPERIMENTAL
  SUSPENDED
}
enum MachineWorkspaceState {
  READY
  LIMITED
  INSTALL_REQUIRED
  INCOMPATIBLE
  OWNER_DISABLED
}
enum WorkspaceSessionStatus {
  RESERVED
  PREPARING
  READY
  RUNNING
  STOP_REQUESTED
  STOPPING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  QUARANTINED
}
enum SessionTerminationReason {
  USER_STOP
  OWNER_EMERGENCY_STOP
  PLATFORM_EMERGENCY_STOP
  COMPLETED
  TIMEOUT
  AGENT_OFFLINE
  SECURITY_POLICY
  EXECUTION_FAILED
}
model User {
  id String @id @default(cuid())
  wallet String @unique
  pseudonym String @unique
  email String? @unique
  firstName String?
  lastName String?
  phone String?
  countryCode String?
  language String @default("fr")
  canRent Boolean @default(true)
  canHost Boolean @default(false)
  profileCompletedAt DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  profile Profile?
  machines Machine[]
  listings GpuListing[]
  bookings Booking[] @relation("BuyerBookings")
  reviewsWritten Review[] @relation("ReviewsWritten")
  forumTopics ForumTopic[]
  forumPosts ForumPost[]
  conversationMembers ConversationMember[]
  messages Message[]
  jobs Job[]
  workspaceSessions WorkspaceSession[]
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  bio String?
  avatarUrl String?
  companyName String?
  websiteUrl String?
  reliabilityScore Int @default(0)
  completedSessions Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Machine {
  id String @id @default(cuid())
  ownerId String
  agentPublicKey String @unique
  agentVersion String?
  keyCreatedAt DateTime @default(now())
  keyLastUsedAt DateTime?
  keyRevokedAt DateTime?
  operatingSystem String?
  osVersion String?
  cpuModel String?
  cpuCount Int?
  ramTotalMiB Int?
  diskTotalMiB Int?
  cudaVersion String?
  dockerAvailable Boolean @default(false)
  nvidiaRuntimeAvailable Boolean @default(false)
  virtualizationAvailable Boolean @default(false)
  connectivity MachineConnectivity @default(OFFLINE)
  operational MachineOperational @default(UNAVAILABLE)
  moderationStatus ModerationStatus @default(CLEAR)
  lastHeartbeatAt DateTime?
  lastCounter BigInt @default(0)
  gpuUuid String?
  gpuModel String?
  vramMiB Int?
  driverVersion String?
  lastCudaProbeOk Boolean @default(false)
  verifiedAt DateTime?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings GpuListing[]
  heartbeats Heartbeat[]
  jobs Job[]
  workspaceSessions WorkspaceSession[]
  workspaces MachineWorkspace[]
}
model GpuListing {
  id String @id @default(cuid())
  ownerId String
  machineId String
  title String @db.VarChar(120)
  description String @db.VarChar(3000)
  hourlyLamports BigInt
  status ListingStatus @default(PENDING_GPU_VERIFICATION)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])
  bookings Booking[]
  @@index([status, createdAt])
}
model Booking {
  id String @id @default(cuid())
  buyerId String
  listingId String
  idempotencyKey String
  startsAt DateTime
  endsAt DateTime
  quotedLamports BigInt
  validSeconds Int @default(0)
  expectedSeconds Int
  status BookingStatus @default(CREATED)
  escrowAddress String?
  depositSignature String? @unique
  createdAt DateTime @default(now())
  buyer User @relation("BuyerBookings", fields: [buyerId], references: [id])
  listing GpuListing @relation(fields: [listingId], references: [id])
  payment Payment?
  usageSamples UsageSample[]
  reviews Review[]
  jobs Job[]
  workspaceSessions WorkspaceSession[]
  @@unique([buyerId, idempotencyKey])
  @@index([listingId, startsAt, endsAt])
}
model WorkspaceDefinition {
  id String @id @default(cuid())
  slug String @unique @db.VarChar(80)
  version Int @default(1)
  name String @db.VarChar(120)
  category String @db.VarChar(40)
  release WorkspaceRelease @default(UPCOMING)
  globallyEnabled Boolean @default(true)
  manifest Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  machines MachineWorkspace[]
}
model MachineWorkspace {
  id String @id @default(cuid())
  machineId String
  workspaceId String
  compatibilityScore Int
  state MachineWorkspaceState
  enabledByOwner Boolean @default(false)
  analysis Json
  configuration Json?
  hourlyLamports BigInt?
  analyzedAt DateTime @default(now())
  testedAt DateTime?
  sessions WorkspaceSession[]
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  workspace WorkspaceDefinition @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  @@unique([machineId, workspaceId])
  @@index([machineId, enabledByOwner, state])
}
model WorkspaceSession {
  id String @id @default(cuid())
  bookingId String
  renterId String
  machineId String
  machineWorkspaceId String
  jobId String? @unique
  status WorkspaceSessionStatus @default(RESERVED)
  isolationType String @db.VarChar(32)
  resourceLimits Json
  connectionType String? @db.VarChar(32)
  connectionMetadata Json?
  lastMetricCounter BigInt @default(0)
  startedAt DateTime?
  readyAt DateTime?
  endedAt DateTime?
  expiresAt DateTime
  terminationReason SessionTerminationReason?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  renter User @relation(fields: [renterId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  machineWorkspace MachineWorkspace @relation(fields: [machineWorkspaceId], references: [id], onDelete: Restrict)
  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  metrics WorkspaceMetric[]
  events WorkspaceSessionEvent[]
  @@index([renterId, createdAt])
  @@index([machineId, status])
  @@index([bookingId])
}
model WorkspaceMetric {
  id String @id @default(cuid())
  sessionId String
  counter BigInt
  capturedAt DateTime
  intervalSeconds Int
  gpuUtilization Int
  memoryUsedMiB Int
  temperatureC Int
  cpuUtilization Int
  ramUsedMiB Int
  diskUsedMiB Int
  networkRxBytes BigInt
  networkTxBytes BigInt
  available Boolean
  workloadProof Boolean
  signatureHash String @unique
  session WorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, counter])
  @@index([sessionId, capturedAt])
}
model WorkspaceSessionEvent {
  id String @id @default(cuid())
  sessionId String
  actorType String @db.VarChar(24)
  actorId String?
  action String @db.VarChar(80)
  details Json?
  createdAt DateTime @default(now())
  session WorkspaceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}
model Job {
  id String @id @default(cuid())
  bookingId String
  renterId String
  machineId String
  type JobType
  status JobStatus @default(QUEUED)
  parameters Json
  result Json?
  errorCode String?
  cancelRequestedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  renter User @relation(fields: [renterId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  attempts JobAttempt[]
  logs JobLog[]
  artifacts JobArtifact[]
  workspaceSession WorkspaceSession?
  @@index([renterId, createdAt])
  @@index([machineId, status, createdAt])
}
model JobAttempt {
  id String @id @default(cuid())
  jobId String
  sequence Int
  agentVersion String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  exitCode Int?
  failureReason String?
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, sequence])
}
model JobLog {
  id String @id @default(cuid())
  jobId String
  level String @db.VarChar(16)
  message String @db.VarChar(2000)
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}
model JobArtifact {
  id String @id @default(cuid())
  jobId String
  kind String @db.VarChar(32)
  sha256 String @db.VarChar(64)
  sizeBytes Int
  storageKey String @db.VarChar(500)
  createdAt DateTime @default(now())
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}
model Payment {
  id String @id @default(cuid())
  bookingId String @unique
  grossLamports BigInt
  payableLamports BigInt @default(0)
  platformLamports BigInt @default(0)
  providerLamports BigInt @default(0)
  refundLamports BigInt @default(0)
  status PaymentStatus @default(ESCROW_PENDING)
  settlementSignature String? @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
model Heartbeat {
  id String @id @default(cuid())
  machineId String
  counter BigInt
  agentTimestamp DateTime
  receivedAt DateTime @default(now())
  gpuUtilization Int
  memoryUsedMiB Int
  temperatureC Int
  cudaProbeOk Boolean
  sessionId String?
  signatureHash String @unique
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  @@unique([machineId, counter])
  @@index([machineId, receivedAt])
}
model UsageSample {
  id String @id @default(cuid())
  bookingId String
  timestamp DateTime
  available Boolean
  workloadProof Boolean
  gpuUtilization Int
  temperatureC Int
  sourceHash String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@unique([bookingId, timestamp])
}
model Conversation {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  members ConversationMember[]
  messages Message[]
}
model ConversationMember {
  conversationId String
  userId String
  joinedAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String @db.VarChar(4000)
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}
model Review {
  id String @id @default(cuid())
  bookingId String
  reviewerId String
  rating Int
  comment String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id])
  reviewer User @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  @@unique([bookingId, reviewerId])
}
model ForumTopic {
  id String @id @default(cuid())
  authorId String
  title String @db.VarChar(160)
  body String @db.VarChar(10000)
  category String @db.VarChar(80)
  locked Boolean @default(false)
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id])
  posts ForumPost[]
}
model ForumPost {
  id String @id @default(cuid())
  topicId String
  authorId String
  body String @db.VarChar(10000)
  createdAt DateTime @default(now())
  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}
