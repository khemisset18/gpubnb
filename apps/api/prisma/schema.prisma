generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MachineConnectivity {
  OFFLINE
  ONLINE
}

enum MachineOperational {
  UNAVAILABLE
  VERIFYING
  AVAILABLE
  RESERVED
  RUNNING
  DEGRADED
  MAINTENANCE
}

enum ModerationStatus {
  CLEAR
  SUSPENDED
  QUARANTINED
}

enum ListingStatus {
  DRAFT
  PENDING_GPU_VERIFICATION
  ACTIVE
  RESERVED
  HIDDEN_OFFLINE
  SUSPENDED
}

enum BookingStatus {
  CREATED
  AWAITING_DEPOSIT
  FUNDED
  STARTING
  ACTIVE
  DEGRADED
  COMPLETED
  DISPUTED
  SETTLED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  ESCROW_PENDING
  ESCROW_FUNDED
  SETTLEMENT_PENDING
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
  RELEASED
  FROZEN
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  NEW_DEVICE
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  IDENTITY_LINKED
  IDENTITY_UNLINKED
  WALLET_LINKED
  WALLET_UNLINKED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETED
}

enum AccountDeletionStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model User {
  id             String    @id @default(cuid())
  /// Transitional source field retained until every deployment has completed migration 0003.
  wallet         String?   @unique
  pseudonym      String    @unique @db.VarChar(32)
  sessionVersion Int       @default(1)
  disabledAt     DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile                   Profile?
  identities                AuthIdentity[]
  wallets                   UserWallet[]
  sessions                  UserSession[]
  securityEvents            SecurityEvent[]
  notificationPreference    NotificationPreference?
  accountDeletionRequests   AccountDeletionRequest[]
  machines                  Machine[]
  listings                  GpuListing[]
  bookings                  Booking[]               @relation("BuyerBookings")
  reviewsWritten            Review[]                @relation("ReviewsWritten")
  forumTopics               ForumTopic[]
  forumPosts                ForumPost[]
  conversationMembers       ConversationMember[]
  messages                  Message[]
}

model Profile {
  id                String  @id @default(cuid())
  userId            String  @unique
  displayName       String? @db.VarChar(80)
  bio               String? @db.VarChar(1000)
  avatarUrl         String? @db.VarChar(2048)
  countryCode       String? @db.Char(2)
  locale            String  @default("en") @db.VarChar(16)
  timezone          String  @default("UTC") @db.VarChar(64)
  profilePublic     Boolean @default(true)
  reliabilityScore  Int     @default(0)
  completedSessions Int     @default(0)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id            String    @id @default(cuid())
  userId        String
  provider      String    @db.VarChar(32)
  subject       String    @db.VarChar(255)
  email         String?   @db.VarChar(320)
  emailVerified Boolean   @default(false)
  linkedAt      DateTime  @default(now())
  lastUsedAt    DateTime?
  disabledAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@index([email])
}

model UserWallet {
  id              String    @id @default(cuid())
  userId          String
  address         String    @unique @db.VarChar(64)
  label           String?   @db.VarChar(80)
  canAuthenticate Boolean   @default(false)
  canPay          Boolean   @default(true)
  canReceive      Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique @db.Char(64)
  sessionVersion Int
  userAgentHash  String?   @db.Char(64)
  ipPrefixHash   String?   @db.Char(64)
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  idleExpiresAt  DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  revokeReason   String?   @db.VarChar(64)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id            String            @id @default(cuid())
  userId        String?
  type          SecurityEventType
  success       Boolean           @default(true)
  ipPrefixHash  String?           @db.Char(64)
  userAgentHash String?           @db.Char(64)
  metadata      Json?
  createdAt     DateTime          @default(now())
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  securityEmail  Boolean @default(true)
  bookingEmail   Boolean @default(true)
  marketingEmail Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountDeletionRequest {
  id          String                @id @default(cuid())
  userId      String
  status      AccountDeletionStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  executeAt   DateTime
  completedAt DateTime?
  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status, executeAt])
}

model Machine {
  id                String              @id @default(cuid())
  ownerId           String
  agentPublicKey    String              @unique
  connectivity      MachineConnectivity @default(OFFLINE)
  operational       MachineOperational  @default(UNAVAILABLE)
  moderationStatus  ModerationStatus    @default(CLEAR)
  lastHeartbeatAt   DateTime?
  lastCounter       BigInt              @default(0)
  gpuUuid           String?
  gpuModel          String?
  vramMiB           Int?
  driverVersion     String?
  lastCudaProbeOk   Boolean             @default(false)
  verifiedAt        DateTime?
  owner             User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings          GpuListing[]
  heartbeats        Heartbeat[]

  @@index([ownerId])
}

model GpuListing {
  id             String        @id @default(cuid())
  ownerId        String
  machineId      String
  title          String        @db.VarChar(120)
  description    String        @db.VarChar(3000)
  hourlyLamports BigInt
  status         ListingStatus @default(PENDING_GPU_VERIFICATION)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  owner          User          @relation(fields: [ownerId], references: [id])
  machine        Machine       @relation(fields: [machineId], references: [id])
  bookings       Booking[]

  @@index([status, createdAt])
  @@index([machineId])
  @@index([ownerId])
}

model Booking {
  id               String        @id @default(cuid())
  buyerId          String
  listingId        String
  idempotencyKey   String
  startsAt         DateTime
  endsAt           DateTime
  quotedLamports   BigInt
  validSeconds     Int           @default(0)
  expectedSeconds  Int
  status           BookingStatus @default(CREATED)
  escrowAddress    String?
  depositSignature String?       @unique
  createdAt        DateTime      @default(now())
  buyer            User          @relation("BuyerBookings", fields: [buyerId], references: [id])
  listing          GpuListing    @relation(fields: [listingId], references: [id])
  payment          Payment?
  usageSamples     UsageSample[]
  reviews          Review[]

  @@unique([buyerId, idempotencyKey])
  @@index([listingId, startsAt, endsAt])
  @@index([buyerId])
}

model Payment {
  id                  String        @id @default(cuid())
  bookingId           String        @unique
  grossLamports       BigInt
  payableLamports     BigInt        @default(0)
  platformLamports    BigInt        @default(0)
  providerLamports    BigInt        @default(0)
  refundLamports      BigInt        @default(0)
  status              PaymentStatus @default(ESCROW_PENDING)
  settlementSignature String?       @unique
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Heartbeat {
  id             String   @id @default(cuid())
  machineId      String
  counter        BigInt
  agentTimestamp DateTime
  receivedAt     DateTime @default(now())
  gpuUtilization Int
  memoryUsedMiB  Int
  temperatureC   Int
  cudaProbeOk    Boolean
  sessionId      String?
  signatureHash  String   @unique
  machine        Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, counter])
  @@index([machineId, receivedAt])
}

model UsageSample {
  id            String   @id @default(cuid())
  bookingId     String
  timestamp     DateTime
  available     Boolean
  workloadProof Boolean
  gpuUtilization Int
  temperatureC  Int
  sourceHash    String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, timestamp])
}

model Conversation {
  id        String               @id @default(cuid())
  createdAt DateTime             @default(now())
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(4000)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewer   User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])

  @@unique([bookingId, reviewerId])
  @@index([reviewerId])
}

model ForumTopic {
  id        String      @id @default(cuid())
  authorId  String
  title     String      @db.VarChar(160)
  body      String      @db.VarChar(10000)
  category  String      @db.VarChar(80)
  locked    Boolean     @default(false)
  createdAt DateTime    @default(now())
  author    User        @relation(fields: [authorId], references: [id])
  posts     ForumPost[]

  @@index([authorId])
}

model ForumPost {
  id        String     @id @default(cuid())
  topicId   String
  authorId  String
  body      String     @db.VarChar(10000)
  createdAt DateTime   @default(now())
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id])

  @@index([authorId])
}
