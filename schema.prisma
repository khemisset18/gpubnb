generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum MachineConnectivity { OFFLINE ONLINE }
enum MachineOperational { UNAVAILABLE VERIFYING AVAILABLE RESERVED RUNNING DEGRADED MAINTENANCE }
enum ModerationStatus { CLEAR SUSPENDED QUARANTINED }
enum ListingStatus { DRAFT PENDING_GPU_VERIFICATION ACTIVE RESERVED HIDDEN_OFFLINE SUSPENDED }
enum BookingStatus { CREATED AWAITING_DEPOSIT FUNDED STARTING ACTIVE DEGRADED COMPLETED DISPUTED SETTLED REFUNDED CANCELLED }
enum PaymentStatus { ESCROW_PENDING ESCROW_FUNDED SETTLEMENT_PENDING PARTIALLY_REFUNDED FULLY_REFUNDED RELEASED FROZEN }
model User { id String @id @default(cuid()) wallet String @unique pseudonym String @unique lastLoginAt DateTime? createdAt DateTime @default(now()) profile Profile? machines Machine[] listings GpuListing[] bookings Booking[] @relation("BuyerBookings") reviewsWritten Review[] @relation("ReviewsWritten") forumTopics ForumTopic[] forumPosts ForumPost[] conversationMembers ConversationMember[] messages Message[] }
model Profile { id String @id @default(cuid()) userId String @unique bio String? avatarUrl String? reliabilityScore Int @default(0) completedSessions Int @default(0) user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Machine { id String @id @default(cuid()) ownerId String agentPublicKey String @unique connectivity MachineConnectivity @default(OFFLINE) operational MachineOperational @default(UNAVAILABLE) moderationStatus ModerationStatus @default(CLEAR) lastHeartbeatAt DateTime? lastCounter BigInt @default(0) gpuUuid String? gpuModel String? vramMiB Int? driverVersion String? lastCudaProbeOk Boolean @default(false) verifiedAt DateTime? owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade) listings GpuListing[] heartbeats Heartbeat[] }
model GpuListing { id String @id @default(cuid()) ownerId String machineId String title String @db.VarChar(120) description String @db.VarChar(3000) hourlyLamports BigInt status ListingStatus @default(PENDING_GPU_VERIFICATION) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User @relation(fields:[ownerId],references:[id]) machine Machine @relation(fields:[machineId],references:[id]) bookings Booking[] @@index([status,createdAt]) }
model Booking { id String @id @default(cuid()) buyerId String listingId String idempotencyKey String startsAt DateTime endsAt DateTime quotedLamports BigInt validSeconds Int @default(0) expectedSeconds Int status BookingStatus @default(CREATED) escrowAddress String? depositSignature String? @unique createdAt DateTime @default(now()) buyer User @relation("BuyerBookings",fields:[buyerId],references:[id]) listing GpuListing @relation(fields:[listingId],references:[id]) payment Payment? usageSamples UsageSample[] reviews Review[] @@unique([buyerId,idempotencyKey]) @@index([listingId,startsAt,endsAt]) }
model Payment { id String @id @default(cuid()) bookingId String @unique grossLamports BigInt payableLamports BigInt @default(0) platformLamports BigInt @default(0) providerLamports BigInt @default(0) refundLamports BigInt @default(0) status PaymentStatus @default(ESCROW_PENDING) settlementSignature String? @unique booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) }
model Heartbeat { id String @id @default(cuid()) machineId String counter BigInt agentTimestamp DateTime receivedAt DateTime @default(now()) gpuUtilization Int memoryUsedMiB Int temperatureC Int cudaProbeOk Boolean sessionId String? signatureHash String @unique machine Machine @relation(fields:[machineId],references:[id],onDelete:Cascade) @@unique([machineId,counter]) @@index([machineId,receivedAt]) }
model UsageSample { id String @id @default(cuid()) bookingId String timestamp DateTime available Boolean workloadProof Boolean gpuUtilization Int temperatureC Int sourceHash String @unique booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade) @@unique([bookingId,timestamp]) }
model Conversation { id String @id @default(cuid()) createdAt DateTime @default(now()) members ConversationMember[] messages Message[] }
model ConversationMember { conversationId String userId String joinedAt DateTime @default(now()) conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@id([conversationId,userId]) }
model Message { id String @id @default(cuid()) conversationId String senderId String body String @db.VarChar(4000) createdAt DateTime @default(now()) conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade) sender User @relation(fields:[senderId],references:[id],onDelete:Cascade) @@index([conversationId,createdAt]) }
model Review { id String @id @default(cuid()) bookingId String reviewerId String rating Int comment String? createdAt DateTime @default(now()) booking Booking @relation(fields:[bookingId],references:[id]) reviewer User @relation("ReviewsWritten",fields:[reviewerId],references:[id]) @@unique([bookingId,reviewerId]) }
model ForumTopic { id String @id @default(cuid()) authorId String title String @db.VarChar(160) body String @db.VarChar(10000) category String @db.VarChar(80) locked Boolean @default(false) createdAt DateTime @default(now()) author User @relation(fields:[authorId],references:[id]) posts ForumPost[] }
model ForumPost { id String @id @default(cuid()) topicId String authorId String body String @db.VarChar(10000) createdAt DateTime @default(now()) topic ForumTopic @relation(fields:[topicId],references:[id],onDelete:Cascade) author User @relation(fields:[authorId],references:[id]) }
