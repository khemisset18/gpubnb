[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=GPUbnbIdd.cat
DriverVer=09/18/2026,0.1.0.0

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=GPUbnbIdd_Install,Root\GPUbnbVirtualDisplay
%DeviceName%=GPUbnbIdd_Install,GPUbnbVirtualDisplay

[SourceDisksFiles]
GPUbnbIdd.dll=1

[SourceDisksNames]
1=%DiskName%

[GPUbnbIdd_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=GPUbnbIdd_Copy

[GPUbnbIdd_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=GPUbnbIdd_HardwareSettings

[GPUbnbIdd_HardwareSettings]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"GPUbnbVirtualDisplay-UMDF-v1"

[GPUbnbIdd_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[GPUbnbIdd_Install.NT.Wdf]
UmdfService=GPUbnbIdd,GPUbnbIdd_Service
UmdfServiceOrder=GPUbnbIdd
UmdfKernelModeClientPolicy=AllowKernelModeClients

[GPUbnbIdd_Service]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\GPUbnbIdd.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
GPUbnbIdd_Copy=12,UMDF

[GPUbnbIdd_Copy]
GPUbnbIdd.dll

[Strings]
ManufacturerName="GPUbnb"
DiskName="GPUbnb Virtual Display Driver"
DeviceName="GPUbnb Isolated Virtual Display"

REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
