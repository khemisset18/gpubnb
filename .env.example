NODE_ENV=development
PORT=8787
# PostgreSQL connection string (Supabase Session Pooler port 5432 is supported)
DATABASE_URL=
# Redis connection string; production requires TLS (rediss://)
REDIS_URL=
SESSION_COOKIE_NAME=gpubnb_session
SESSION_TTL_SECONDS=86400
SESSION_SECRET=
INTERNAL_SERVICE_TOKEN=
PUBLIC_APP_DOMAIN=localhost
PLATFORM_WALLET=B5WQmXWHL8R86wf3LHLRE4aQAuRdRSz1EXKcwNQDqj2e
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=finalized
ESCROW_PROGRAM_ID=NOT_DEPLOYED_YET
ALLOW_MAINNET=false
HEARTBEAT_MAX_AGE_SECONDS=25
HEARTBEAT_OFFLINE_SECONDS=40
COMMISSION_BPS=500
SESSION_IDLE_TTL_SECONDS=3600
TRUST_PROXY=false
MAX_BODY_BYTES=131072
# Agent production hardening
GPUBNB_CA_FILE=
GPUBNB_APPARMOR_PROFILE=gpubnb-workload

# Optional but required for Google/e-mail sign-in exchange
SUPABASE_URL=
SUPABASE_ANON_KEY=
