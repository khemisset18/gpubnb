NODE_ENV=development
PORT=8787
# Supabase Transaction Pooler URI (runtime)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase Direct connection URI (migrations)
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Upstash Redis TLS URI, beginning with rediss://
REDIS_URL=rediss://default:PASSWORD@HOST:6379
PUBLIC_APP_ORIGIN=http://localhost:8080
SESSION_COOKIE_NAME=gpubnb_session
SESSION_TTL_SECONDS=86400
SESSION_SECRET=replace-with-64-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-64-random-characters
PLATFORM_WALLET=B5WQmXWHL8R86wf3LHLRE4aQAuRdRSz1EXKcwNQDqj2e
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
ESCROW_PROGRAM_ID=REPLACE_AFTER_ANCHOR_DEPLOY
ALLOW_MAINNET=false
HEARTBEAT_MAX_AGE_SECONDS=25
HEARTBEAT_OFFLINE_SECONDS=40
COMMISSION_BPS=500
