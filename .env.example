# GPUbnb safe local/CI template — never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local infrastructure
DATABASE_URL=postgresql://gpubnb:gpubnb@localhost:5432/gpubnb?schema=public
# Matches docker-compose.yml's `redis-server --requirepass change-me` — following
# this file with REDIS_URL=redis://localhost:6379 (no password) fails with NOAUTH.
REDIS_URL=redis://:change-me@localhost:6379

# Authentication and cryptography — replace locally with generated secrets.
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
INTERNAL_SERVICE_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Signed agent heartbeat policy.
HEARTBEAT_MAX_AGE_SECONDS=25
HEARTBEAT_OFFLINE_SECONDS=60

# Global control-plane migration. Keep legacy until shadow parity and failover
# qualification are green. Region names are deployment identifiers, not cloud
# provider credentials (examples: eu-west, us-east, ap-south).
CONTROL_PLANE_REGION=local
MACHINE_PRESENCE_MODE=legacy
MACHINE_PRESENCE_TTL_SECONDS=60
RESOURCE_LEASE_TTL_SECONDS=45

# Regional Connection Gateway v1. These are service-level settings; the gateway
# should receive its real TLS paths, Redis URL and internal token from the
# deployment secret manager rather than this file.
GPUBNB_CONTROL_GATEWAY_ID=gateway_local_0001
GPUBNB_CONTROL_REGION=local
GPUBNB_CONTROL_QUIC_BIND=0.0.0.0:4443
GPUBNB_CONTROL_ADMIN_BIND=127.0.0.1:9090
GPUBNB_CONTROL_TLS_CERT=/path/to/control-gateway-cert.pem
GPUBNB_CONTROL_TLS_KEY=/path/to/control-gateway-key.pem
GPUBNB_CONTROL_REDIS_URL=redis://:change-me@localhost:6379
GPUBNB_CONTROL_INTERNAL_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
GPUBNB_CONTROL_MAX_CONNECTIONS=50000
GPUBNB_CONTROL_CONNECTION_QUEUE=128
GPUBNB_CONTROL_PENDING_PER_MACHINE=256
GPUBNB_CONTROL_PRESENCE_TTL_SECONDS=60
GPUBNB_CONTROL_HEARTBEAT_TIMEOUT_SECONDS=45
GPUBNB_CONTROL_AUTH_CLOCK_SKEW_SECONDS=30
GPUBNB_CONTROL_COMMAND_RETENTION_SECONDS=300
GPUBNB_CONTROL_MAX_FRAME_BYTES=65536

# Agent Control Channel v1. Rollout is intentionally zero by default. Configure
# the public DNS/SNI only after the regional gateway is deployed dark and its
# synthetic qualification is green. Never put an internal service token in the
# public assignment returned to a Host.
# CONTROL_GATEWAY_PUBLIC_HOST=gateway-eu.example.com
CONTROL_GATEWAY_PUBLIC_PORT=4443
# CONTROL_GATEWAY_TLS_SERVER_NAME=gateway-eu.example.com
AGENT_CONTROL_CHANNEL_ROLLOUT_BPS=0
AGENT_CONTROL_FALLBACK_POLL_SECONDS=120

# Durable direct-command and scheduler-presence cutovers. Both cohorts MUST stay
# inside AGENT_CONTROL_CHANNEL_ROLLOUT_BPS; the API/worker rejects an unsafe
# configuration instead of silently widening the canary. The admin URL/token are
# private service-to-service coordinates and must come from the deployment secret
# manager in production. Keep both rollouts at zero until dark qualification.
# CONTROL_GATEWAY_ADMIN_URL=http://127.0.0.1:9090
CONTROL_GATEWAY_INTERNAL_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
MACHINE_COMMAND_GATEWAY_ROLLOUT_BPS=0
SCHEDULER_HOT_PRESENCE_ROLLOUT_BPS=0

# A job with no status update for this long is treated as stale regardless of
# whether its machine is still heartbeating (see job-staleness-sweep.ts).
JOB_STALE_AFTER_SECONDS=900
JOB_RECLAIM_AFTER_SECONDS=45

# Solana Devnet only by default.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
ALLOW_MAINNET=false
PLATFORM_WALLET=B5WQmXWHL8R86wf3LHLRE4aQAuRdRSz1EXKcwNQDqj2e
ESCROW_PROGRAM_ID=REPLACE_WITH_DEVNET_PROGRAM_ID

# Browser/API origins; keep explicit in production.
PUBLIC_APP_DOMAIN=localhost
PUBLIC_SITE_URL=http://localhost:8888
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8888,http://localhost:3000

# Optional external authentication. Leave empty for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
