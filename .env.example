# Copy this file to .env for local development. Never commit the resulting .env.
# Values below are placeholders or public Devnet identifiers, never credentials.

# API runtime
NODE_ENV=development
PORT=8787
PUBLIC_APP_DOMAIN=localhost
TRUST_PROXY=false
MAX_BODY_BYTES=131072

# PostgreSQL / Prisma. DIRECT_URL is reserved for providers that expose a
# separate non-pooled migration endpoint; the current Prisma schema uses
# DATABASE_URL only.
DATABASE_URL=postgresql://gpubnb:replace_me@127.0.0.1:5432/gpubnb
DIRECT_URL=postgresql://gpubnb:replace_me@127.0.0.1:5432/gpubnb

# Redis (use rediss:// in production)
REDIS_URL=redis://:change-me@127.0.0.1:6379

# Server-side session and internal API security. Generate independent values,
# each with at least 32 random bytes (for example: openssl rand -base64 48).
SESSION_COOKIE_NAME=gpubnb_session
SESSION_TTL_SECONDS=86400
SESSION_IDLE_TTL_SECONDS=3600
SESSION_SECRET=replace_with_at_least_32_random_bytes
INTERNAL_SERVICE_TOKEN=replace_with_a_different_32_byte_random_value

# Supabase. The anon key is public by design. A service-role key is documented
# for operator provisioning only and MUST NOT be exposed to apps/web; the API
# currently does not consume it.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=replace_with_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured in Supabase and Google Cloud, not read directly by
# this API. Keep the client secret only in the Supabase provider dashboard.
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=configure_only_in_supabase_dashboard
FRONTEND_URL=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:8787
# Public API origin injected into a standalone Netlify frontend build.
GPUBNB_API_URL=http://localhost:8787

# Solana / escrow. No private key or keypair belongs in an environment file.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=finalized
ESCROW_PROGRAM_ID=NOT_DEPLOYED_YET
PLATFORM_WALLET=B5WQmXWHL8R86wf3LHLRE4aQAuRdRSz1EXKcwNQDqj2e
COMMISSION_BPS=500
ALLOW_MAINNET=false

# GPU agent and heartbeat policy. GPUBNB_AGENT_PRIVATE_KEY is intentionally not
# given a value: provision it out-of-band on the provider host.
HEARTBEAT_MAX_AGE_SECONDS=25
HEARTBEAT_OFFLINE_SECONDS=40
GPUBNB_API=http://localhost:8787
GPUBNB_MACHINE_ID=replace_with_registered_machine_id
GPUBNB_AGENT_PRIVATE_KEY=
GPUBNB_INTERVAL=10
GPUBNB_COUNTER_FILE=/var/lib/gpubnb/heartbeat-counter
GPUBNB_CA_FILE=/etc/gpubnb/ca.pem

# Workload sandbox host policy
JOB_ROOT=/var/lib/gpubnb/jobs
GPU_DEVICE=0
MAX_RUNTIME=25h
PIDS_LIMIT=256
MEMORY_LIMIT=16g
CPU_LIMIT=8
GPUBNB_APPARMOR_PROFILE=gpubnb-workload

# Render uses NODE_ENV, PORT and the same API variables above. Do not add
# Render API keys to this file; configure deployment credentials in Render and
# GitHub environments.
