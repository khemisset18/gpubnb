NODE_ENV=development
PORT=8787
# Supabase Session Pooler URI ending in :5432/postgres
# Supabase Session pooler, port 5432
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
# Upstash TCP TLS URI
# Upstash TCP TLS, doit commencer par rediss://
REDIS_URL=rediss://default:PASSWORD@HOST:6379
SESSION_COOKIE_NAME=gpubnb_session
SESSION_TTL_SECONDS=86400
SESSION_SECRET=replace-with-64-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-64-random-characters
PUBLIC_APP_DOMAIN=localhost
PLATFORM_WALLET=B5WQmXWHL8R86wf3LHLRE4aQAuRdRSz1EXKcwNQDqj2e
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_COMMITMENT=finalized
ESCROW_PROGRAM_ID=NOT_DEPLOYED_YET
ALLOW_MAINNET=false
HEARTBEAT_MAX_AGE_SECONDS=25
HEARTBEAT_OFFLINE_SECONDS=40
COMMISSION_BPS=500
SESSION_IDLE_TTL_SECONDS=3600
TRUST_PROXY=false
MAX_BODY_BYTES=131072
# Agent production hardening
GPUBNB_CA_FILE=
GPUBNB_APPARMOR_PROFILE=gpubnb-workload
# Agent local : la clé privée et le machineId sont stockés dans le dossier
# local créé par `gpubnb-agent setup`; ne les placez pas dans ce fichier.
GPUBNB_API=https://gpubnb.netlify.app/api
GPUBNB_CONFIG_DIR=

# Optional but required for Google/e-mail sign-in exchange
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY # gitleaks:allow
