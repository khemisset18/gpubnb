  "evidence": {
    "constructor": "LiteSVM::new -> into_basic always enables builtins, sysvars, signature verification and blockhash checks; only precompile account loading is conditional.",
    "transactionVerification": "send_transaction -> sanitize_transaction(self.sigverify) -> SanitizedTransaction::verify -> Signature::verify -> solana_ed25519::VerificationKey::verify_dalek. This path does not use agave_precompiles or ed25519-dalek1.",
    "signing": "solana-keypair3.1.2 uses ed25519-dalek2.2.0; separate from the optional instruction-precompile implementation.",
    "programCpi": "The only explicit program invoke transfers through SystemProgram. The two typed SystemProgram accounts service init/open; Anchor init generation uses SystemProgram create_account. No program instruction invokes a signature precompile.",
    "pda": "PDA derivation and the VM cryptographic syscalls remain available; omitting precompile program accounts is not omitting those syscalls.",
    "negativeChecks": "SignatureFailure, BlockhashNotFound and identical-tx AlreadyProcessed are exercised, with zero balance/data effect in all eight party/config/escrow snapshots.",
    "rent": "Config/Escrow data size138; expected balances use VM minimum_balance_for_rent_exemption independently from observed funded balances.",
    "scopeChange": "Only the newly added, unused optional test extension may be omitted. All six GPUbnb cases and their assertions must remain unchanged apart from accurate scope labels.",
    "noSecurityGateChanges": "No Trivy exclusions, advisory changes, severity reductions, fake package versions or lock omissions are authorized."
  },
  "requiredNextChecks": [
    "Regenerate runtime lock and prove agave-precompiles/dalek1/curve3/Rand0.7 absent.",
    "Run same six runtime cases against each existing exact ELF with signatures/blockhash checks, System CPI, Rent and snapshot assertions retained.",
    "Scan the complete candidate repository and runtime lock strictly.",
    "Record precompiles NOT_QUALIFIED; do not claim general Solana consensus or precompile validation."
  ]
