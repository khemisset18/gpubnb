+name: stage4-osslsigncode-hardened
+on:
+  push:
+    branches: [prep/stage4-osslsigncode-hardened-20261015]
+    paths:
+      - scripts/third-party/osslsigncode/**
+      - scripts/tests/windows-osslsigncode-hardened-probe.ps1
+      - .github/workflows/stage4-osslsigncode-hardened.yml
+permissions:
+  contents: read
+concurrency:
+  group: stage4-osslsigncode-hardened-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  audited-amd64-build-and-proof:
+    if: ${{ github.event.repository.private == false }}
+    runs-on: windows-2022
+    timeout-minutes: 55
+    steps:
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
+        with:
+          persist-credentials: false
+      - name: Parse all new PowerShell before execution
+        shell: pwsh
+        run: |
+          foreach ($path in @('scripts/third-party/osslsigncode/build-windows.ps1','scripts/tests/windows-osslsigncode-hardened-probe.ps1')) {
+            $tokens=$null; $errors=$null
+            [void][Management.Automation.Language.Parser]::ParseFile((Join-Path $PWD $path),[ref]$tokens,[ref]$errors)
+            if ($errors.Count -ne 0) { $errors | ForEach-Object { Write-Error $_.Message }; exit 1 }
+          }
+      - name: Build pinned static AMD64 tool and test OpenSSL and zlib
+        shell: pwsh
+        run: |
+          & ./scripts/third-party/osslsigncode/build-windows.ps1 -OutputDirectory (Join-Path $env:RUNNER_TEMP ('gpubnb-hardened-build-'+[Guid]::NewGuid().ToString('N')))
+          if (-not $?) { exit 1 }
+      - name: Unchanged Authenticode regression suite on PowerShell 7
+        shell: pwsh
+        run: |
+          & ./scripts/tests/verify-windows-authenticode.tests.ps1
+          if (-not $?) { exit 1 }
+      - name: Unchanged Authenticode regression suite on Windows PowerShell 5.1
+        shell: powershell
+        run: |
+          & ./scripts/tests/verify-windows-authenticode.tests.ps1
+          if (-not $?) { exit 1 }
+      - name: Four negative controls and Windows SignTool interoperability
+        shell: pwsh
+        run: |
+          & ./scripts/tests/windows-osslsigncode-hardened-probe.ps1
+          if (-not $?) { exit 1 }
+      - name: Delete temporary build and disposable fixtures
+        if: ${{ always() }}
+        shell: pwsh
+        run: |
+          if ($env:GPUBNB_HARDENED_BUILD_ROOT -and (Test-Path -LiteralPath $env:GPUBNB_HARDENED_BUILD_ROOT)) {
+            $root=[IO.Path]::GetFullPath($env:GPUBNB_HARDENED_BUILD_ROOT)
+            $temp=[IO.Path]::GetFullPath($env:RUNNER_TEMP)+[IO.Path]::DirectorySeparatorChar
+            if (-not $root.StartsWith($temp,[StringComparison]::OrdinalIgnoreCase)) { throw 'cleanup_path_outside_runner_temp' }
+            Remove-Item -LiteralPath $root -Recurse -Force
+          }
+# Public standard runner, logs only: no secrets, artifact storage or cache.
