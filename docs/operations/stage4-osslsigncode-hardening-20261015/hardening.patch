+}
+$cert.Dispose()
+Write-Host 'GPUBNB_PUBLIC_FIXTURES_JSON_BEGIN'
+$report|ConvertTo-Json -Depth 12|Write-Host
+Write-Host 'GPUBNB_PUBLIC_FIXTURES_JSON_END'
+if(-not $report.rootStoresUnchanged){throw 'root_store_changed'}
